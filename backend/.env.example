PORT=5000

# Firebase Admin
FIREBASE_PROJECT_ID=invoice-project-63aba
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Email Provider: 'resend', 'sendgrid', 'gmail', or 'smtp'
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@autoinvoice.app
EMAIL_API_KEY=

# SMTP (for generic SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Gmail App Password (if using EMAIL_PROVIDER=gmail)
EMAIL_APP_PASSWORD=

# Frontend URL (for payment links in emails)
FRONTEND_URL=http://localhost:3000
